{
  "name": "restrocontrol-desktop",
  "version": "0.1.0",
  "private": true,
  "description": "RestroControl Windows desktop shell (Electron) loading the live SaaS app",
  "main": "main.js",
  "scripts": {
    "start": "electron .",
    "build:nsis": "node scripts/prepare-icon.mjs && electron-builder --win nsis",
    "prepare:icon": "node scripts/prepare-icon.mjs"
  },
  "devDependencies": {
    "electron": "^33.2.0",
    "electron-builder": "^25.1.8"
  },
  "build": {
    "appId": "com.restrocontrol.app",
    "productName": "RestroControl",
    "asar": true,
    "directories": {
      "output": "dist"
    },
    "files": [
      "main.js",
      "package.json"
    ],
    "win": {
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        }
      ],
      "icon": "build/icon.ico"
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "RestroControl"
    },
    "artifactName": "RestroControl-Setup-${version}.exe"
  }
}
