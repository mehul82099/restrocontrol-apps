{
  "appId": "com.restrocontrol.app",
  "appName": "RestroControl",
  "webDir": "dist",
  "server": {
    "url": "https://restrocontrol.new.tg",
    "androidScheme": "https",
    "cleartext": false
  },
  "android": {
    "allowMixedContent": false
  },
  "plugins": {
    "SplashScreen": {
      "launchShowDuration": 1500,
      "backgroundColor": "#0f172a",
      "androidScaleType": "CENTER_CROP",
      "showSpinner": false
    },
    "StatusBar": {
      "style": "LIGHT",
      "backgroundColor": "#0f172a"
    }
  }
}
